          <ns0:characteristics>
            <ns0:characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Monstrous Creature</ns0:characteristic>
            <ns0:characteristic name="WS" typeId="575323232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="425323232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="S" typeId="5323232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="T" typeId="5423232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="W" typeId="5723232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="I" typeId="4923232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="A" typeId="4123232344415441232323">6</ns0:characteristic>
            <ns0:characteristic name="LD" typeId="4c4423232344415441232323">10</ns0:characteristic>
