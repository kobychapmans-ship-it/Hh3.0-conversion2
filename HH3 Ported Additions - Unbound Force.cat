    <ns0:selectionEntry id="d752ad17-e726-5b4c-afb2-e5bb6827b58a" name="Horus Ascended [Lords of War]" hidden="false" collective="false" import="true" type="unit">
      <ns0:modifiers>
        <ns0:modifier type="set" field="hidden" value="true">
          <ns0:conditions>
            <ns0:condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="10558e9c-1ed5-57c4-bfcc-447b494893f2" type="equalTo" />
          </ns0:conditions>
        </ns0:modifier>
      </ns0:modifiers>
      <ns0:categoryLinks>
        <ns0:categoryLink id="b8959c93-c95d-5b95-b8b0-40ddc5c3341f" hidden="false" targetId="5edda62e-b4ba-5416-8a58-bf82ff751acc" primary="true" />
      </ns0:categoryLinks>
      <ns0:profiles>
        <ns0:profile id="bbc45e7e-7623-5228-8c69-2f110c46d9e0" name="Horus Ascended" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <ns0:characteristics>
            <ns0:characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Monstrous Creature</ns0:characteristic>
            <ns0:characteristic name="WS" typeId="575323232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="425323232344415441232323">6</ns0:characteristic>
            <ns0:characteristic name="S" typeId="5323232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="T" typeId="5423232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="W" typeId="5723232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="I" typeId="4923232344415441232323">6</ns0:characteristic>
            <ns0:characteristic name="A" typeId="4123232344415441232323">6</ns0:characteristic>
            <ns0:characteristic name="LD" typeId="4c4423232344415441232323">10</ns0:characteristic>
            <ns0:characteristic name="Save" typeId="5361766523232344415441232323">-</ns0:characteristic>
          </ns0:characteristics>
