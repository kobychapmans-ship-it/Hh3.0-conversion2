      <ns0:modifiers>
        <ns0:modifier type="set" field="hidden" value="true">
          <ns0:conditions>
            <ns0:condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1703783a-181e-536b-a8d3-c6ee37dc5435" type="equalTo" />
