          </ns0:conditions>
        </ns0:modifier>
      </ns0:modifiers>
      <ns0:categoryLinks>
        <ns0:categoryLink id="a31164ff-195d-5643-86ba-c39430482e88" hidden="false" targetId="5edda62e-b4ba-5416-8a58-bf82ff751acc" primary="true" />
      </ns0:categoryLinks>
      <ns0:profiles>
        <ns0:profile id="9f848127-bf70-5a94-84bd-86fc81ff087d" name="Fulgrim Transfigured" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <ns0:characteristics>
            <ns0:characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Monstrous Creature</ns0:characteristic>
            <ns0:characteristic name="WS" typeId="575323232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="425323232344415441232323">6</ns0:characteristic>
            <ns0:characteristic name="S" typeId="5323232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="T" typeId="5423232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="W" typeId="5723232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="I" typeId="4923232344415441232323">8</ns0:characteristic>
            <ns0:characteristic name="A" typeId="4123232344415441232323">7</ns0:characteristic>
            <ns0:characteristic name="LD" typeId="4c4423232344415441232323">10</ns0:characteristic>
            <ns0:characteristic name="Save" typeId="5361766523232344415441232323">2+/4++</ns0:characteristic>
