      <ns0:modifiers>
        <ns0:modifier type="set" field="hidden" value="true">
          <ns0:conditions>
            <ns0:condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="10558e9c-1ed5-57c4-bfcc-447b494893f2" type="equalTo" />
